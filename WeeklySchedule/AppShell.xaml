<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="WeeklySchedule.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:WeeklySchedule"
       xmlns:vm="clr-namespace:WeeklySchedule.ViewModels"
       xmlns:strings="clr-namespace:WeeklySchedule.Resources.Strings"
       Title="WeeklySchedule"
       FlyoutBehavior="Flyout">
    <Shell.FlyoutContent>
        <Grid x:Name="FlyoutGrid" RowDefinitions="*, Auto" 
              BackgroundColor="{StaticResource SurfaceBrush}">
            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Default">
                <VerticalStackLayout Padding="12, 24, 12, 24" Spacing="8">
                    <CollectionView ItemsSource="{Binding Timelines}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimelineFlyoutItem">
                                <Border StrokeShape="RoundRectangle 16" Margin="0, 2" Padding="0" StrokeThickness="0" BackgroundColor="Transparent" Shadow="{x:Null}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.SelectTimelineCommand, Source={x:Reference FlyoutGrid}}" 
                                            CommandParameter="{Binding Timeline}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto, *" Padding="16, 12">
                                        <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center" Margin="0, 0, 12, 0" Spacing="8">
                                            <Path Data="{StaticResource IconStar}" 
                                                WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center"
                                                Fill="{StaticResource AccentBrush}"
                                                IsVisible="{Binding IsHighlighted}" />
                                            <Path Data="{StaticResource IconNotifications}" 
                                                WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center"
                                                Fill="{StaticResource AccentBrush}"
                                                IsVisible="{Binding NotificationsEnabled}" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" VerticalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Style" Value="{StaticResource BodyBold}" />
                                                    <Setter Property="TextColor" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="{x:Static strings:AppResources.NoTimelines}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="0,24,0,0" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0,12,24">
                <BoxView HeightRequest="1" Color="{StaticResource OutlineBrush}" Opacity="0.3" Margin="16,0,16,12"/>

                <Border StrokeShape="RoundRectangle 16" Margin="0, 2" Padding="0" StrokeThickness="0" BackgroundColor="Transparent" Shadow="{x:Null}">
                    <Grid ColumnDefinitions="Auto, *" Padding="16, 12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimelinesManageClicked" />
                        </Grid.GestureRecognizers>
                        <Path Grid.Column="0" Data="{StaticResource IconCalendar}" 
                              WidthRequest="24" HeightRequest="24" Aspect="Uniform"
                              VerticalOptions="Center" Margin="0, 0, 12, 0"
                              Fill="{StaticResource AccentBrush}" />
                        <Label Grid.Column="1" Text="{x:Static strings:AppResources.Timelines}" Style="{StaticResource Body}" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 16" Margin="0, 2" Padding="0" StrokeThickness="0" BackgroundColor="Transparent" Shadow="{x:Null}">
                    <Grid ColumnDefinitions="Auto, *" Padding="16, 12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsClicked" />
                        </Grid.GestureRecognizers>
                        <Path Grid.Column="0" Data="{StaticResource IconSettings}" 
                              WidthRequest="24" HeightRequest="24" Aspect="Uniform"
                              VerticalOptions="Center" Margin="0, 0, 12, 0"
                              Fill="{StaticResource AccentBrush}" />
                        <Label Grid.Column="1" Text="{x:Static strings:AppResources.Settings}" Style="{StaticResource Body}" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 16" Margin="0, 2" Padding="0" StrokeThickness="0" BackgroundColor="Transparent" Shadow="{x:Null}">
                    <Grid ColumnDefinitions="Auto, *" Padding="16, 12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAboutClicked" />
                        </Grid.GestureRecognizers>
                        <Path Grid.Column="0" Data="{StaticResource IconInfo}" 
                              WidthRequest="24" HeightRequest="24" Aspect="Uniform"
                              VerticalOptions="Center" Margin="0, 0, 12, 0"
                              Fill="{StaticResource AccentBrush}" />
                        <Label Grid.Column="1" Text="{x:Static strings:AppResources.AboutTitle}" Style="{StaticResource Body}" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutContent>
    <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
</Shell>