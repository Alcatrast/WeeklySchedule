<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeeklySchedule.ViewModels"
             xmlns:models="clr-namespace:WeeklySchedule.Models"
             xmlns:views="clr-namespace:WeeklySchedule.Views"
             x:Class="WeeklySchedule.Views.TimelinesPage"
             x:Name="TimelinesPageRoot"
             x:DataType="vm:TimelinesViewModel"
             Title="Таймлайны">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding CreateTimelineCommand}" SemanticProperties.Description="Добавить таймлайн" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15, 10" ColumnSpacing="10">
            <Label Text="Открывать последний выбранный" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center"/>
            <Switch Grid.Column="1" 
                    IsToggled="{Binding OpenLastTimeline}" 
                    VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Timelines}" Spacing="10" Padding="15">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Timeline">
                        <!-- Цвета нейтральные и от таймлайна не зависят: выделение
                             активного таймлайна показывает иконка-звезда ниже -->
                        <Border StrokeShape="RoundRectangle 12" Padding="20" StrokeThickness="2"
                                BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#2C2C2C}"
                                Stroke="{AppThemeBinding Light=#ACACAC, Dark=#555555}">
                            <Grid ColumnDefinitions="*, Auto">
                            <Grid ColumnDefinitions="Auto, *" BackgroundColor="Transparent"
                                  views:PressFeedback.IsEnabled="True"
                                  views:ContextActions.TapCommand="{Binding BindingContext.EditTimelineCommand, Source={x:Reference TimelinesPageRoot}}"
                                  views:ContextActions.MenuCommand="{Binding BindingContext.TimelineActionsCommand, Source={x:Reference TimelinesPageRoot}}"
                                  views:ContextActions.Parameter="{Binding .}">
                                <!-- Контейнер для иконок -->
                                <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center" Margin="0, 0, 10, 0" Spacing="4" InputTransparent="True">
                                    <Path Data="{StaticResource IconStar}" 
                      WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center"
                      Fill="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}">
                                        <Path.Triggers>
                                            <DataTrigger TargetType="Path" Value="False">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource IsEqualConverter}">
                                                        <Binding Path="Id" />
                                                        <Binding Path="BindingContext.HighlightedTimelineId" Source="{x:Reference TimelinesPageRoot}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Path.Triggers>
                                    </Path>

                                    <Path Data="{StaticResource IconNotifications}" 
                      WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center"
                      Fill="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                      IsVisible="{Binding NotificationsEnabled}" />
                                </HorizontalStackLayout>

                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" InputTransparent="True" />
                            </Grid>
                            <Button Grid.Column="1" Text="⋮" FontSize="22" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}" SemanticProperties.Description="Действия с таймлайном"
                                    Command="{Binding BindingContext.TimelineActionsCommand, Source={x:Reference TimelinesPageRoot}}" CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
