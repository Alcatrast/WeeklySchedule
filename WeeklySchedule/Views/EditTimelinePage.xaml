<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:vm="clr-namespace:WeeklySchedule.ViewModels" 
             x:Class="WeeklySchedule.Views.EditTimelinePage"
             xmlns:strings="clr-namespace:WeeklySchedule.Resources.Strings"
             x:DataType="vm:EditTimelineViewModel">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="24" VerticalOptions="Start">
                <Label Text="{Binding Title}" Style="{StaticResource Title}" HorizontalOptions="Center" Margin="0,8,0,0" />
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.TimelineName}" Style="{StaticResource BodyBold}"/>
                    <Entry Text="{Binding Name}" Placeholder="{x:Static strings:AppResources.TimelineNamePlaceholder}"/>
                </VerticalStackLayout>
                <Border Style="{StaticResource CardContainer}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleIsStartupCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{x:Static strings:AppResources.MakeStartup}" Style="{StaticResource BodyBold}" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding IsStartupTimeline}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardContainer}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleNotificationsCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{x:Static strings:AppResources.EnableNotifications}" Style="{StaticResource BodyBold}" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Label Text="{x:Static strings:AppResources.PermissionWarning}" Style="{StaticResource Caption}" TextColor="{StaticResource DangerBrush}" FontAttributes="Italic" IsVisible="{Binding ShowPermissionWarning}" />
                <Border Style="{StaticResource PrimaryActionButton}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Path Data="{StaticResource IconSave}" Fill="White" WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="{x:Static strings:AppResources.Save}" Style="{StaticResource ButtonText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Style="{StaticResource DangerActionButton}" IsVisible="{Binding IsEditMode}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Path Data="{StaticResource IconDeleteForever}" Fill="White" WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="{x:Static strings:AppResources.Delete}" Style="{StaticResource ButtonTextDanger}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Style="{StaticResource OutlineActionButton}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Path Data="{StaticResource IconCancel}" Fill="{StaticResource AccentBrush}" WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="{x:Static strings:AppResources.Cancel}" Style="{StaticResource ButtonTextOutline}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <BoxView HeightRequest="1" Color="{StaticResource OutlineBrush}" Opacity="0.3" Margin="0,16,0,0"/>
                <Label Text="{Binding ImportSectionTitle}" Style="{StaticResource Subtitle}" HorizontalOptions="Center" />
                <Border x:Name="ImportButton" 
        Style="{StaticResource GradientActionButton}" 
        Background="{StaticResource ExcelImportGradient}">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectExcelFileCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Path Data="{StaticResource IconAddCircle}" Fill="White" WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="{x:Static strings:AppResources.ExcelImport}" Style="{StaticResource ButtonText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border x:Name="ImportWscButton" Style="{StaticResource OutlineActionButton}" Margin="0,10,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ImportWscCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Path Data="{StaticResource IconAddCircle}" Fill="{StaticResource AccentBrush}" WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="{x:Static strings:AppResources.WscImport}" Style="{StaticResource ButtonTextOutline}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="16" Margin="0,16,0,0">
                    <BoxView HeightRequest="1" Color="{StaticResource OutlineBrush}" Opacity="0.3"/>
                    <Label Text="{x:Static strings:AppResources.Export}" Style="{StaticResource Subtitle}" HorizontalOptions="Center" />
                    <Border x:Name="ExportWscButton" Style="{StaticResource OutlineActionButton}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ExportWscCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                            <Path Data="{StaticResource IconSave}" Fill="{StaticResource AccentBrush}" WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                            <Label Text="{x:Static strings:AppResources.WscExport}" Style="{StaticResource ButtonTextOutline}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Grid IsVisible="{Binding IsWscProcessing}" 
              BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}" 
              InputTransparent="False" 
              ZIndex="999">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <ActivityIndicator IsRunning="True" Color="{StaticResource AccentBrush}" WidthRequest="56" HeightRequest="56" />
                <Label Style="{StaticResource Body}" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static strings:AppResources.Processing}" />
                            <Span Text="&#x0a;" />
                            <Span Text="{x:Static strings:AppResources.PleaseWait}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>