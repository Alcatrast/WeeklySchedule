<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:vm="clr-namespace:WeeklySchedule.ViewModels" 
             x:Class="WeeklySchedule.Views.EditTimelinePage"
             xmlns:strings="clr-namespace:WeeklySchedule.Resources.Strings"
             x:DataType="vm:EditTimelineViewModel">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20" VerticalOptions="Start">
                <Label Text="{Binding Title}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

                <Label Text="{x:Static strings:AppResources.TimelineName}" FontSize="14" FontAttributes="Bold"/>
                <Entry Text="{Binding Name}" Placeholder="{x:Static strings:AppResources.TimelineNamePlaceholder}" FontSize="16" />

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,10,0,0">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleIsStartupCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static strings:AppResources.MakeStartup}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Switch Grid.Column="1" IsToggled="{Binding IsStartupTimeline}" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,10,0,0">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleNotificationsCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static strings:AppResources.EnableNotifications}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" VerticalOptions="Center" />
                </Grid>

                <Label Text="{x:Static strings:AppResources.PermissionWarning}" TextColor="{StaticResource Danger}" FontSize="12" FontAttributes="Italic" IsVisible="{Binding ShowPermissionWarning}" Margin="0,5,0,0" />

                <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 12" HeightRequest="50" HorizontalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Path Data="{StaticResource IconSave}" Fill="White" WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="{x:Static strings:AppResources.Save}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Danger}" StrokeShape="RoundRectangle 12" HeightRequest="50" HorizontalOptions="Fill" IsVisible="{Binding IsEditMode}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Path Data="{StaticResource IconDeleteForever}" Fill="White" WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="{x:Static strings:AppResources.Delete}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Gray500}" HeightRequest="50" HorizontalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Path Data="{StaticResource IconCancel}" Fill="{StaticResource Gray500}" WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="{x:Static strings:AppResources.Cancel}" TextColor="{StaticResource Gray500}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" Margin="0,15,0,5"/>
                <Label Text="{Binding ImportSectionTitle}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />

                <Border x:Name="ImportButton" HeightRequest="50" HorizontalOptions="Fill" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="Transparent">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource GradientStart}" Offset="0.0" />
                            <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectExcelFileCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static strings:AppResources.ExcelImport}" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border x:Name="ImportWscButton" HeightRequest="50" HorizontalOptions="Fill"
                        StrokeShape="RoundRectangle 12" StrokeThickness="1" 
                        Stroke="{StaticResource Gray500}" BackgroundColor="Transparent" Margin="0,10,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ImportWscCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Path Data="{StaticResource IconAddCircle}" Fill="{StaticResource Gray500}"
              WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                        <Label Text="{x:Static strings:AppResources.WscImport}" TextColor="{StaticResource Gray500}"
               FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <VerticalStackLayout IsVisible="{Binding IsEditMode}" Margin="0,15,0,0">
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" Margin="0,0,0,5"/>
                    <Label Text="{x:Static strings:AppResources.Export}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Border x:Name="ExportWscButton" HeightRequest="50" HorizontalOptions="Fill"
                        StrokeShape="RoundRectangle 12" StrokeThickness="1" 
                        Stroke="{StaticResource Gray500}" BackgroundColor="Transparent" Margin="0,10,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ExportWscCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Path Data="{StaticResource IconSave}" Fill="{StaticResource Gray500}"
                                WidthRequest="24" HeightRequest="24" Aspect="Uniform" VerticalOptions="Center" />
                            <Label Text="{x:Static strings:AppResources.WscExport}" TextColor="{StaticResource Gray500}"
                                 FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" Margin="0,15,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
        <Grid IsVisible="{Binding IsWscProcessing}" 
              BackgroundColor="#80000000" 
              InputTransparent="False" 
              ZIndex="999">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="50" HeightRequest="50" />
                <Label FontSize="16" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static strings:AppResources.Processing}" />
                            <Span Text="&#x0a;" />
                            <Span Text="{x:Static strings:AppResources.PleaseWait}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>