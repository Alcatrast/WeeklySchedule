<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeeklySchedule.ViewModels"
             xmlns:views="clr-namespace:WeeklySchedule.Views"
             x:Class="WeeklySchedule.MainPage"
             x:DataType="vm:MainViewModel"
                          Title="{Binding CurrentTimelineName}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Clicked="OnAddLessonClicked" AutomationId="AddLesson" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *" RowSpacing="10" Padding="10, 0, 10, 10">
        <Label Grid.Row="0"
           Text="{Binding SelectedDayVM.DayTitle}"
           FontSize="20"
           FontAttributes="Bold"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           Margin="0,10,0,0">
        </Label>

        <Border Grid.Row="1" IsVisible="{Binding HasBaseDay}"
                HorizontalOptions="Center" Padding="12,6" Margin="5,0"
                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light=#EEE9FA, Dark=#342C48}">
            <Label Text="{Binding BaseDayText}" FontSize="13"
                   TextColor="{AppThemeBinding Light=#51406E, Dark=#E4D8FF}"
                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
        </Border>

        <CarouselView Grid.Row="2"
                      ItemsSource="{Binding Days}"
                      CurrentItem="{Binding SelectedDayVM, Mode=TwoWay}"
                      Loop="True"
                      IsSwipeEnabled="True"
                      HorizontalScrollBarVisibility="Never"
                      VerticalScrollBarVisibility="Never">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:DayViewModel">
                    <views:DayView />
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
    </Grid>
</ContentPage>
