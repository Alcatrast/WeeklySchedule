<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeeklySchedule.ViewModels"
             xmlns:views="clr-namespace:WeeklySchedule.Views"
             x:Class="WeeklySchedule.Views.DayView"
             x:DataType="vm:DayViewModel">
    <ScrollView x:Name="MainScroll" VerticalOptions="Fill">
        <ScrollView.GestureRecognizers>
            <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding CreateLessonCommand}" />
        </ScrollView.GestureRecognizers>
        <views:TimelineGridView x:Name="TimelineGrid" TimelineLayoutData="{Binding Layout}" />
    </ScrollView>
</ContentView>