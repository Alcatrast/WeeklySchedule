<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeeklySchedule.ViewModels"
             x:Class="WeeklySchedule.Views.DayView"
             x:DataType="vm:DayViewModel">

    <ScrollView x:Name="MainScroll" VerticalOptions="Fill">

        <Grid x:Name="TimelineGrid" 
              ColumnSpacing="4" 
              RowSpacing="0" 
              Padding="5,0,5,12"
              VerticalOptions="Start">
        </Grid>

    </ScrollView>
</ContentView>