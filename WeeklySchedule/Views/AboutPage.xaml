<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:WeeklySchedule.Resources.Strings"
             x:Class="WeeklySchedule.Views.AboutPage"
             Title="{x:Static strings:AppResources.AboutTitle}">
    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center" HorizontalOptions="Center">
        <Label Text="{x:Static strings:AppResources.AppName}" Style="{StaticResource Headline}" />
        <Label x:Name="VersionLabel" Style="{StaticResource Body}" TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" HorizontalOptions="Center" />
        <Label Text="{x:Static strings:AppResources.AboutDesc}" Style="{StaticResource Body}" HorizontalTextAlignment="Center" />
        <Label Text="{x:Static strings:AppResources.AboutDev}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>