<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:WeeklySchedule.Resources.Strings"
             x:Class="WeeklySchedule.Views.AboutPage"
             Title="{x:Static strings:AppResources.AboutTitle}">
    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center" HorizontalOptions="Center">
        <Label Text="{x:Static strings:AppResources.AppName}" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label x:Name="VersionLabel" FontSize="16" TextColor="Gray" HorizontalOptions="Center" />
        <Label Text="{x:Static strings:AppResources.AboutDesc}" FontSize="16" HorizontalTextAlignment="Center" />
        <Label Text="{x:Static strings:AppResources.AboutDev}" FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>